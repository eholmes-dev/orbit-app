# =============================================================================
# Database — Orbit supports two modes; pick ONE.
# =============================================================================

# ─── Mode 1: Full Docker stack (the install path for clients) ──────────────
# Run `npm run docker:up`. The backend container ignores the DATABASE_URL
# below and uses an internal compose URL pointing at the postgres service
# (postgresql://orbit:...@postgres:5432/orbit). You only need to set
# DATABASE_URL here if you'll run Prisma Studio / migrations from the host.
#
# ─── Mode 2: Bundled Postgres + host backend (Phase-1 dev workflow) ─────────
# Run `npm run docker:up postgres` (database only), then run the backend +
# frontend on the host via `npm run dev:*`. Point DATABASE_URL at the
# bundled DB:
#
#   DATABASE_URL="postgresql://orbit:orbit-dev-password@localhost:5432/orbit"
#
# Leave DIRECT_URL UNSET — the prisma-shim wrapper falls back to DATABASE_URL
# for migrations, so you don't have to set the same URL twice.

# ─── Mode 3: Supabase (the project's current dev setup) ─────────────────────
# Pooled URL on port 6543 for runtime queries:
DATABASE_URL="postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-1-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct URL on port 5432 for Prisma migrations (pgbouncer can't run them):
DIRECT_URL="postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-1-REGION.pooler.supabase.com:5432/postgres"

# =============================================================================
# Service ports + internal URLs
# =============================================================================
BACKEND_PORT=4000
FRONTEND_PORT=5173
SCHEDULER_PORT=8000

# URL the backend uses to reach the scheduler microservice.
SCHEDULER_URL=http://localhost:8000

# =============================================================================
# Microsoft Graph OAuth (Phase 3)
# Get these from Azure Portal → App registrations → your app.
# =============================================================================
MS_TENANT_ID="<directory (tenant) id>"
MS_CLIENT_ID="<application (client) id>"
MS_CLIENT_SECRET="<client secret value>"
MS_REDIRECT_URI="http://localhost:4000/api/auth/callback"

# =============================================================================
# Session + URLs
# =============================================================================
# Session secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="<32+ random bytes hex>"

# Frontend base URL — used to redirect after sign-in completes.
APP_BASE_URL="http://localhost:5173"

# Public-facing URL of THIS backend (used in outbound override-request emails
# so the Accept/Decline links resolve). Swap to a real URL once deployed.
BACKEND_PUBLIC_URL="http://localhost:4000"

# =============================================================================
# Bundled-Postgres overrides (only used when `npm run docker:up`)
# =============================================================================
# Override the dev default for production-ish deployments. Leave blank to
# accept the dev default `orbit-dev-password`.
# POSTGRES_PASSWORD="<strong password>"
