{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../.env -- tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "dotenv -e ../.env -- node dist/index.js",
    "prisma:generate": "dotenv -e ../.env -- node scripts/prisma-shim.cjs generate",
    "prisma:migrate": "dotenv -e ../.env -- node scripts/prisma-shim.cjs migrate dev",
    "prisma:migrate:deploy": "dotenv -e ../.env -- node scripts/prisma-shim.cjs migrate deploy",
    "prisma:studio": "dotenv -e ../.env -- node scripts/prisma-shim.cjs studio"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "dotenv-cli": "^7.4.4",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
