// Orbit — healthcare scheduling app
// Full Phase 1 schema. Only Person and Label have UIs in Phase 1,
// but defining everything now avoids painful migrations in Phase 2.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Person {
  id               String            @id @default(cuid())
  name             String
  email            String            @unique
  department       String?
  active           Boolean           @default(true)
  maxHoursPerWeek  Int?
  preferredHours   Int?
  outlookAccountId String?
  labels           Label[]           @relation("PersonLabels")
  availability     Availability[]
  assignments      Assignment[]
  blackoutDates    BlackoutDate[]
  archiveEntries   ArchiveEntry[]
  overrideRequests OverrideRequest[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Label {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  people      Person[] @relation("PersonLabels")
  events      Event[]  @relation("EventLabels")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Event {
  id                 String            @id @default(cuid())
  title              String
  startDateTime      DateTime
  endDateTime        DateTime
  priorityTier       Int
  requiredStaffCount Int               @default(1)
  isHardRequirement  Boolean           @default(false)
  recurrenceRule     String?
  location           String?
  cancelledAt        DateTime?
  cancellationReason String?
  requiredLabels     Label[]           @relation("EventLabels")
  assignments        Assignment[]
  archiveEntries     ArchiveEntry[]
  overrideRequests   OverrideRequest[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

enum AvailabilityType {
  vacation
  PTO
  appointment
  blocked
  recurring
}

enum AvailabilitySource {
  manual
  outlook_sync
}

model Availability {
  id              String             @id @default(cuid())
  personId        String
  person          Person             @relation(fields: [personId], references: [id], onDelete: Cascade)
  type            AvailabilityType
  startDateTime   DateTime
  endDateTime     DateTime
  source          AvailabilitySource @default(manual)
  externalEventId String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([personId, startDateTime, endDateTime])
}

model BlackoutDate {
  id       String   @id @default(cuid())
  personId String
  person   Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  date     DateTime
  reason   String?

  @@unique([personId, date])
}

enum AssignmentStatus {
  proposed
  confirmed
  conflict
  declined
}

model Assignment {
  id                String           @id @default(cuid())
  eventId           String
  event             Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  personId          String
  person            Person           @relation(fields: [personId], references: [id], onDelete: Cascade)
  status            AssignmentStatus @default(proposed)
  syncedToOutlookAt DateTime?
  externalEventId   String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([eventId, personId])
}

enum ArchiveKind {
  declined_assignment
  accepted_conflict
  cancelled_event
  reduced_requirement
}

// Unified audit log of admin decisions: every decline, accepted conflict, and
// cancelled event lands here. The Schedule UI consults this to surface the
// archive page; nothing else depends on it for solver behavior (those use
// AssignmentStatus.declined and Event.cancelledAt directly).
model ArchiveEntry {
  id                         String      @id @default(cuid())
  kind                       ArchiveKind
  eventId                    String
  event                      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  personId                   String?
  person                     Person?     @relation(fields: [personId], references: [id], onDelete: SetNull)
  reason                     String?
  conflictReason             String?
  conflictShortBy            Int?
  previousRequiredStaffCount Int?
  newRequiredStaffCount      Int?
  createdAt                  DateTime    @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([eventId])
}

enum OverrideRequestStatus {
  pending
  accepted
  declined
  expired
}

// An email-based "would you cover this shift?" request sent to a person whose
// availability blocks them from an event. The token is the bearer secret in
// the email Accept/Decline URLs (recipient won't be signed in).
model OverrideRequest {
  id            String                @id @default(cuid())
  token         String                @unique
  eventId       String
  event         Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  personId      String
  person        Person                @relation(fields: [personId], references: [id], onDelete: Cascade)
  // Snapshot of what was blocking them at request time. Useful for the email
  // body and for showing the request history later.
  blockingType  String?
  blockingStart DateTime?
  blockingEnd   DateTime?
  message       String?
  status        OverrideRequestStatus @default(pending)
  createdAt     DateTime              @default(now())
  respondedAt   DateTime?
  expiresAt     DateTime

  @@index([eventId, personId, status])
}

// Admin session — created after Microsoft OAuth sign-in. Tokens are encrypted
// at rest using SESSION_SECRET (AES-256-GCM); see backend/src/lib/crypto.ts.
model Session {
  id             String   @id
  msUserId       String
  email          String
  name           String
  accessToken    String
  refreshToken   String
  tokenExpiresAt DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([msUserId])
}
