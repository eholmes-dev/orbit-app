{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.43.8.12551",
      "templateHash": "17139152998996522695"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for all resources. Defaults to the resource group region."
      }
    },
    "namePrefix": {
      "type": "string",
      "defaultValue": "orbit",
      "minLength": 3,
      "maxLength": 11,
      "metadata": {
        "description": "Short prefix used to name every resource (e.g. \"orbit\", \"orbit-prod\"). Lowercase letters and numbers only."
      }
    },
    "adminEmail": {
      "type": "string",
      "metadata": {
        "description": "Email of the first admin user for sign-in. Must match an account in the Entra tenant below."
      }
    },
    "msTenantId": {
      "type": "string",
      "metadata": {
        "description": "Microsoft Entra (Azure AD) tenant ID. The directory hosting your Orbit Entra app registration."
      }
    },
    "msClientId": {
      "type": "string",
      "metadata": {
        "description": "Application (client) ID from your Entra app registration."
      }
    },
    "msClientSecret": {
      "type": "securestring",
      "metadata": {
        "description": "Client secret VALUE (not the secret ID) from your Entra app registration. Stored in Key Vault."
      }
    },
    "backendImage": {
      "type": "string",
      "defaultValue": "ghcr.io/eholmes-dev/orbit-backend:latest",
      "metadata": {
        "description": "Container image for orbit-backend. Override only if you fork and host your own."
      }
    },
    "schedulerImage": {
      "type": "string",
      "defaultValue": "ghcr.io/eholmes-dev/orbit-scheduler:latest",
      "metadata": {
        "description": "Container image for orbit-scheduler. Override only if you fork and host your own."
      }
    },
    "allowedIpRanges": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Comma-separated CIDR ranges allowed to reach the app (e.g. \"203.0.113.0/24, 198.51.100.42/32\"). Leave blank for public access — sign-in is still required either way."
      }
    },
    "sessionSecret": {
      "type": "securestring",
      "defaultValue": "[format('{0}{1}', newGuid(), newGuid())]",
      "metadata": {
        "description": "Auto-generated session secret. Leave at default; Bicep produces a strong value at deploy time."
      }
    },
    "postgresAdminPassword": {
      "type": "securestring",
      "defaultValue": "[format('{0}Aa1!{1}', take(newGuid(), 8), newGuid())]",
      "metadata": {
        "description": "Postgres admin password. Leave at default to auto-generate; will be stored in Key Vault either way."
      }
    }
  },
  "variables": {
    "copy": [
      {
        "name": "ipRestrictions",
        "count": "[length(variables('allowedRangeList'))]",
        "input": {
          "name": "[format('AllowedRange{0}', copyIndex('ipRestrictions'))]",
          "ipAddressRange": "[variables('allowedRangeList')[copyIndex('ipRestrictions')]]",
          "action": "Allow"
        }
      }
    ],
    "suffix": "[take(uniqueString(resourceGroup().id), 6)]",
    "logWorkspaceName": "[format('{0}-logs-{1}', parameters('namePrefix'), variables('suffix'))]",
    "keyVaultName": "[format('{0}-kv-{1}', parameters('namePrefix'), variables('suffix'))]",
    "postgresServerName": "[format('{0}-pg-{1}', parameters('namePrefix'), variables('suffix'))]",
    "managedIdentityName": "[format('{0}-identity', parameters('namePrefix'))]",
    "containerAppEnvName": "[format('{0}-cae', parameters('namePrefix'))]",
    "backendAppName": "[format('{0}-backend', parameters('namePrefix'))]",
    "schedulerAppName": "[format('{0}-scheduler', parameters('namePrefix'))]",
    "allowedRangeList": "[if(empty(parameters('allowedIpRanges')), createArray(), split(replace(parameters('allowedIpRanges'), ' ', ''), ','))]",
    "keyVaultSecretsUserRoleId": "4633458b-17de-408a-b874-0445c86b69e6"
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2022-10-01",
      "name": "[variables('logWorkspaceName')]",
      "location": "[parameters('location')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30
      }
    },
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[variables('managedIdentityName')]",
      "location": "[parameters('location')]"
    },
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-07-01",
      "name": "[variables('keyVaultName')]",
      "location": "[parameters('location')]",
      "properties": {
        "sku": {
          "family": "A",
          "name": "standard"
        },
        "tenantId": "[subscription().tenantId]",
        "enableRbacAuthorization": true,
        "enabledForDeployment": false,
        "enabledForTemplateDeployment": false,
        "enableSoftDelete": true,
        "softDeleteRetentionInDays": 7,
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2023-07-01",
      "name": "[format('{0}/{1}', variables('keyVaultName'), 'session-secret')]",
      "properties": {
        "value": "[parameters('sessionSecret')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]"
      ]
    },
    {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2023-07-01",
      "name": "[format('{0}/{1}', variables('keyVaultName'), 'ms-client-secret')]",
      "properties": {
        "value": "[parameters('msClientSecret')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]"
      ]
    },
    {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2023-07-01",
      "name": "[format('{0}/{1}', variables('keyVaultName'), 'postgres-password')]",
      "properties": {
        "value": "[parameters('postgresAdminPassword')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]",
      "name": "[guid(resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('managedIdentityName')), variables('keyVaultSecretsUserRoleId'))]",
      "properties": {
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('managedIdentityName')), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('keyVaultSecretsUserRoleId'))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('managedIdentityName'))]"
      ]
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers",
      "apiVersion": "2023-12-01-preview",
      "name": "[variables('postgresServerName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_B1ms",
        "tier": "Burstable"
      },
      "properties": {
        "version": "16",
        "administratorLogin": "orbit",
        "administratorLoginPassword": "[parameters('postgresAdminPassword')]",
        "storage": {
          "storageSizeGB": 32,
          "autoGrow": "Enabled"
        },
        "backup": {
          "backupRetentionDays": 7,
          "geoRedundantBackup": "Disabled"
        },
        "highAvailability": {
          "mode": "Disabled"
        },
        "network": {
          "publicNetworkAccess": "Enabled"
        }
      }
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/databases",
      "apiVersion": "2023-12-01-preview",
      "name": "[format('{0}/{1}', variables('postgresServerName'), 'orbit')]",
      "properties": {
        "charset": "UTF8",
        "collation": "en_US.utf8"
      },
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('postgresServerName'))]"
      ]
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/firewallRules",
      "apiVersion": "2023-12-01-preview",
      "name": "[format('{0}/{1}', variables('postgresServerName'), 'AllowAllAzureServicesAndResourcesWithinAzureIps')]",
      "properties": {
        "startIpAddress": "0.0.0.0",
        "endIpAddress": "0.0.0.0"
      },
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('postgresServerName'))]"
      ]
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "name": "[variables('containerAppEnvName')]",
      "location": "[parameters('location')]",
      "properties": {
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', variables('logWorkspaceName')), '2022-10-01').customerId]",
            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', variables('logWorkspaceName')), '2022-10-01').primarySharedKey]"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logWorkspaceName'))]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[variables('schedulerAppName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('managedIdentityName')))]": {}
        }
      },
      "properties": {
        "environmentId": "[resourceId('Microsoft.App/managedEnvironments', variables('containerAppEnvName'))]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "ingress": {
            "external": false,
            "targetPort": 8000,
            "transport": "http",
            "allowInsecure": true
          }
        },
        "template": {
          "containers": [
            {
              "name": "scheduler",
              "image": "[parameters('schedulerImage')]",
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1Gi"
              }
            }
          ],
          "scale": {
            "minReplicas": 0,
            "maxReplicas": 2
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', variables('containerAppEnvName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('managedIdentityName'))]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[variables('backendAppName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('managedIdentityName')))]": {}
        }
      },
      "properties": {
        "environmentId": "[resourceId('Microsoft.App/managedEnvironments', variables('containerAppEnvName'))]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "ingress": {
            "external": true,
            "targetPort": 4000,
            "transport": "auto",
            "allowInsecure": false,
            "ipSecurityRestrictions": "[variables('ipRestrictions')]"
          },
          "secrets": [
            {
              "name": "session-secret",
              "keyVaultUrl": "[reference(resourceId('Microsoft.KeyVault/vaults/secrets', variables('keyVaultName'), 'session-secret'), '2023-07-01').secretUri]",
              "identity": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('managedIdentityName'))]"
            },
            {
              "name": "ms-client-secret",
              "keyVaultUrl": "[reference(resourceId('Microsoft.KeyVault/vaults/secrets', variables('keyVaultName'), 'ms-client-secret'), '2023-07-01').secretUri]",
              "identity": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('managedIdentityName'))]"
            },
            {
              "name": "postgres-password",
              "keyVaultUrl": "[reference(resourceId('Microsoft.KeyVault/vaults/secrets', variables('keyVaultName'), 'postgres-password'), '2023-07-01').secretUri]",
              "identity": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('managedIdentityName'))]"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "backend",
              "image": "[parameters('backendImage')]",
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1Gi"
              },
              "env": [
                {
                  "name": "PG_HOST",
                  "value": "[reference(resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('postgresServerName')), '2023-12-01-preview').fullyQualifiedDomainName]"
                },
                {
                  "name": "PG_USER",
                  "value": "orbit"
                },
                {
                  "name": "PG_DATABASE",
                  "value": "orbit"
                },
                {
                  "name": "PG_PASSWORD",
                  "secretRef": "postgres-password"
                },
                {
                  "name": "DIRECT_URL",
                  "value": ""
                },
                {
                  "name": "SESSION_SECRET",
                  "secretRef": "session-secret"
                },
                {
                  "name": "MS_CLIENT_SECRET",
                  "secretRef": "ms-client-secret"
                },
                {
                  "name": "MS_TENANT_ID",
                  "value": "[parameters('msTenantId')]"
                },
                {
                  "name": "MS_CLIENT_ID",
                  "value": "[parameters('msClientId')]"
                },
                {
                  "name": "MS_ADMIN_EMAILS",
                  "value": "[parameters('adminEmail')]"
                },
                {
                  "name": "SCHEDULER_URL",
                  "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', variables('schedulerAppName')), '2024-03-01').configuration.ingress.fqdn)]"
                },
                {
                  "name": "APP_BASE_URL",
                  "value": "[format('https://{0}.{1}', variables('backendAppName'), reference(resourceId('Microsoft.App/managedEnvironments', variables('containerAppEnvName')), '2024-03-01').defaultDomain)]"
                },
                {
                  "name": "BACKEND_PUBLIC_URL",
                  "value": "[format('https://{0}.{1}', variables('backendAppName'), reference(resourceId('Microsoft.App/managedEnvironments', variables('containerAppEnvName')), '2024-03-01').defaultDomain)]"
                },
                {
                  "name": "MS_REDIRECT_URI",
                  "value": "[format('https://{0}.{1}/api/auth/callback', variables('backendAppName'), reference(resourceId('Microsoft.App/managedEnvironments', variables('containerAppEnvName')), '2024-03-01').defaultDomain)]"
                },
                {
                  "name": "NODE_OPTIONS",
                  "value": "--dns-result-order=ipv4first"
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 3
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', variables('containerAppEnvName'))]",
        "[extensionResourceId(resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName')), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('managedIdentityName')), variables('keyVaultSecretsUserRoleId')))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('managedIdentityName'))]",
        "[resourceId('Microsoft.KeyVault/vaults/secrets', variables('keyVaultName'), 'ms-client-secret')]",
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers/databases', variables('postgresServerName'), 'orbit')]",
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('postgresServerName'))]",
        "[resourceId('Microsoft.KeyVault/vaults/secrets', variables('keyVaultName'), 'postgres-password')]",
        "[resourceId('Microsoft.App/containerApps', variables('schedulerAppName'))]",
        "[resourceId('Microsoft.KeyVault/vaults/secrets', variables('keyVaultName'), 'session-secret')]"
      ]
    }
  ],
  "outputs": {
    "appUrl": {
      "type": "string",
      "metadata": {
        "description": "Public URL of the deployed Orbit app. Open this in a browser after deploy."
      },
      "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', variables('backendAppName')), '2024-03-01').configuration.ingress.fqdn)]"
    },
    "redirectUri": {
      "type": "string",
      "metadata": {
        "description": "OAuth redirect URI to register in your Entra app registration."
      },
      "value": "[format('https://{0}/api/auth/callback', reference(resourceId('Microsoft.App/containerApps', variables('backendAppName')), '2024-03-01').configuration.ingress.fqdn)]"
    },
    "postgresHost": {
      "type": "string",
      "metadata": {
        "description": "Postgres server hostname (for manual queries via psql or pgAdmin)."
      },
      "value": "[reference(resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('postgresServerName')), '2023-12-01-preview').fullyQualifiedDomainName]"
    },
    "keyVaultName": {
      "type": "string",
      "metadata": {
        "description": "Name of the Key Vault holding deploy-time secrets."
      },
      "value": "[variables('keyVaultName')]"
    }
  }
}